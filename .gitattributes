# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Force LF for these (web/text files — sempre LF, anche su Windows working copy)
*.js    text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.php   text eol=lf
*.env   text eol=lf
*.sh    text eol=lf
*.lock  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Force CRLF for Windows-only files (batch scripts)
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary files (mai toccare line endings)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.zip   binary
*.gz    binary